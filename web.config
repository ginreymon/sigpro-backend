<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <system.webServer>

    <handlers>
      <remove name="WebDAV" />
      <add name="DjangoHandler"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\inetpub\wwwroot\SIGPRO\backend\venv\Scripts\python.exe|C:\inetpub\wwwroot\SIGPRO\backend\venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <modules runAllManagedModulesForAllRequests="true">
      <remove name="WebDAVModule" />
    </modules>

    <defaultDocument enabled="false" />

    <fastCgi>
      <application
        fullPath="C:\inetpub\wwwroot\SIGPRO\backend\venv\Scripts\python.exe"
        arguments="C:\inetpub\wwwroot\SIGPRO\backend\venv\Lib\site-packages\wfastcgi.py"
        maxInstances="4"
        idleTimeout="600"
        activityTimeout="1200"
        requestTimeout="1200"
        instanceMaxRequests="10000"
        protocol="NamedPipe"
        flushNamedPipe="false">
        <environmentVariables>
          <environmentVariable name="DJANGO_SETTINGS_MODULE" value="config.settings" />
          <environmentVariable name="PYTHONPATH"             value="C:\inetpub\wwwroot\SIGPRO\backend" />
          <environmentVariable name="WSGI_HANDLER"           value="config.wsgi.application" />
        </environmentVariables>
      </application>
    </fastCgi>

    <security>
      <requestFiltering allowDoubleEscaping="true">
        <verbs allowUnlisted="true">
          <add verb="GET"     allowed="true" />
          <add verb="POST"    allowed="true" />
          <add verb="PUT"     allowed="true" />
          <add verb="PATCH"   allowed="true" />
          <add verb="DELETE"  allowed="true" />
          <add verb="HEAD"    allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <httpErrors errorMode="Detailed" />

  </system.webServer>

  <appSettings>
    <add key="DJANGO_SETTINGS_MODULE" value="config.settings" />
    <add key="PYTHONPATH"             value="C:\inetpub\wwwroot\SIGPRO\backend" />
    <add key="WSGI_HANDLER"           value="config.wsgi.application" />
  </appSettings>

</configuration>
